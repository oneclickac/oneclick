local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local BASE = "workspace/Jiggy Menu/settings"

if not isfolder("workspace") then makefolder("workspace") end
if not isfolder("workspace/Jiggy Menu") then makefolder("workspace/Jiggy Menu") end
if not isfolder(BASE) then makefolder(BASE) end

local DEFAULT_FILE = BASE .. "/defaults.json"

local function getPath(name)
    return BASE .. "/" .. name .. ".cfg"
end

local lastLoadedConfig = nil

local function serializeValue(value)
    if typeof(value) == "Color3" then
        return {value.R, value.G, value.B}
    elseif typeof(value) == "EnumItem" then
        local enumString = tostring(value)
        local enumTypeName, enumValueName = enumString:match("^Enum%.([^%.]+)%.(.+)$")
        if enumTypeName and enumValueName then
            return {enumTypeName, enumValueName}
        end
        return {"KeyCode", enumString}
    end
    return value
end

local function deserializeValue(opt, value)
    if opt.type == "colorpicker" then
        if type(value) == "table" and value[1] and value[2] and value[3] then
            return Color3.new(value[1], value[2], value[3])
        end
    elseif opt.type == "keybind" then
        if type(value) == "table" then
            local enumTypeName = value[1]
            local enumValueName = value[2]
            local enumType = Enum[enumTypeName]
            if enumType and enumType[enumValueName] then
                return enumType[enumValueName]
            end
            warn("[Config Warning] Invalid keybind: " .. tostring(enumTypeName) .. "." .. tostring(enumValueName))
        end
    end
    return value
end

local function loadDefaults()
    if not isfile(DEFAULT_FILE) then return {} end
    local data = HttpService:JSONDecode(readfile(DEFAULT_FILE))
    if type(data) ~= "table" then return {} end
    return data
end

local function saveDefaults(data)
    writefile(DEFAULT_FILE, HttpService:JSONEncode(data))
end

function library:createConfig()
    local name = library.flags.config_name
    if not name or name == "" then
        return library:notify("Config", "Enter a config name", "warn", 4)
    end
    if isfile(getPath(name)) then
        return library:notify("Config", name .. ".cfg already exists", "warn", 4)
    end

    local data = {}
    for flag, value in pairs(library.flags) do
        local opt = library.options[flag]
        if not opt or opt.skipflag then continue end
        data[flag] = serializeValue(value)
    end

    writefile(getPath(name), HttpService:JSONEncode(data))
    library:notify("Config", "Created " .. name, "success", 4)
    library:refreshConfigs()
end

function library:saveConfig()
    local name = library.flags.selected_config
    if not name or name == "" then
        return library:notify("Config", "No config selected", "warn", 4)
    end

    local data = {}
    for flag, value in pairs(library.flags) do
        local opt = library.options[flag]
        if not opt or opt.skipflag then continue end
        data[flag] = serializeValue(value)
    end

    writefile(getPath(name), HttpService:JSONEncode(data))
    library:notify("Config", "Updated " .. name, "success", 4)
    library:refreshConfigs()
end

function library:loadConfig()
    local name = library.flags.selected_config
    if not name or name == "" then
        return library:notify("Config", "No config selected", "warn", 4)
    end

    local path = getPath(name)
    if not isfile(path) then
        return library:notify("Config", "Config not found", "error", 4)
    end

    local data = HttpService:JSONDecode(readfile(path))
    if type(data) ~= "table" then
        return library:notify("Config", "Failed to load config", "error", 4)
    end

    for flag, opt in pairs(library.options) do
        if opt.skipflag then continue end
        local value = data[flag]
        if value ~= nil then
            local newValue = deserializeValue(opt, value)
            if newValue ~= nil then
                opt.changeState(newValue)
            end
        end
    end

    lastLoadedConfig = name
    library:notify("Config", "Loaded " .. name, "success", 4)
end

function library:deleteConfig()
    local name = library.flags.selected_config
    if not name or name == "" then return end

    local path = getPath(name)
    if isfile(path) then
        delfile(path)
        if lastLoadedConfig == name then lastLoadedConfig = nil end
        library:notify("Config", "Deleted " .. name, "info", 4)
        library:refreshConfigs()
    end
end

function library:refreshConfigs()
    local list = {}
    for _, file in ipairs(listfiles(BASE)) do
        local name = file:match("([^/\\]+)%.cfg$")
        if name then table.insert(list, name) end
    end

    local dropdown = library.options.selected_config
    if dropdown and dropdown.refresh then
        dropdown.refresh(list)
    end
end

function library:setDefaultConfig()
    local name = library.flags.selected_config
    if not name or name == "" then
        return library:notify("Config", "No config selected", "warn", 4)
    end

    local placeId = tostring(game.PlaceId)
    local defaults = loadDefaults()
    defaults[placeId] = name
    saveDefaults(defaults)
    library:notify("Config", name .. " set as default for this game", "success", 4)
end

function library:clearDefaultConfig()
    local placeId = tostring(game.PlaceId)
    local defaults = loadDefaults()
    defaults[placeId] = nil
    saveDefaults(defaults)
    library:notify("Config", "Default cleared for this game", "info", 4)
end

function library:autoLoadDefault()
    local placeId = tostring(game.PlaceId)
    local defaults = loadDefaults()
    local name = defaults[placeId]
    if not name or name == "" then return end

    local path = getPath(name)
    if not isfile(path) then
        return library:notify("Config", "Default config '" .. name .. "' not found", "warn", 4)
    end

    local data = HttpService:JSONDecode(readfile(path))
    if type(data) ~= "table" then
        return library:notify("Config", "Failed to auto-load default config", "error", 4)
    end

    for flag, opt in pairs(library.options) do
        if opt.skipflag then continue end
        local value = data[flag]
        if value ~= nil then
            local newValue = deserializeValue(opt, value)
            if newValue ~= nil then
                opt.changeState(newValue)
            end
        end
    end

    lastLoadedConfig = name
    library:notify("Config", "Auto-loaded default: " .. name, "success", 4)
end

