                end
                if next then
                    if not table.find(library.blacklisted, key) then
                        next = false
                        if typeof(key) ~= "EnumItem" then key = Enum.KeyCode.Unknown end
                        library.flags[args.flag] = key
                        button.Text = keyNames[key] or (key and key.Name or "Unknown")
                        button.TextColor3 = Color3.fromRGB(155, 155, 155)
                    end
                end
